        transform: rotate(180deg) !important;\n            }\n        }\n\n        @keyframes fadeIn {\n            from {\n                opacity: 0;\n                transform: translateY(10px);\n            }\n\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .animate-fade-in {\n            animation: fadeIn 0.4s ease-out forwards;\n        }\n\n        /* Waline 二级评论样式优化 */\n        #waline .wl-quote,\n        html.dark #waline .wl-quote {\n            background: transparent !important;\n            background-color: transparent !important;\n        }\n\n        #waline .wl-quote .wl-card,\n        html.dark #waline .wl-quote .wl-card {\n            background: transparent !important;\n            background-color: transparent !important;\n            border: none !important;\n            box-shadow: none !important;\n        }\n\n        /* Waline 评论内超链接及图片适配 */\n        #waline .wl-content a {\n            word-break: break-all !important;\n            overflow-wrap: break-word !important;\n        }\n\n        #waline .wl-content img {\n            max-width: 100% !important;\n            height: auto !important;\n            border-radius: 0.375rem;\n        }\n    </style>\n</head>\n\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col pt-[60px]\">\n    <!-- Navbar -->\n    <nav class=\"fixed top-0 left-0 w-full h-[60px] bg-darkNav shadow-md z-50 px-4 flex items-center\">\n        <div class=\"max-w-6xl mx-auto w-full h-full flex justify-between items-center relative\">\n            <a href=\"https://gh-proxy.com/\" class=\"flex items-center gap-3 h-full no-underline group\">\n                <i class=\"fab fa-github text-white text-2xl group-hover:scale-110 transition-transform\"></i>\n                <h1\n                    class=\"text-xl font-bold text-gradient whitespace-nowrap overflow-hidden text-ellipsis max-w-[180px]\">\n                    GitHub加速</h1