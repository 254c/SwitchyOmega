">\n                        <h4 class=\"text-lg font-bold text-slate-800 flex items-center gap-2 mb-4\">\n                            <i class=\"fas fa-exclamation-triangle text-primary\"></i> 注意事项\n                        </h4>\n                        <ul class=\"space-y-3 text-slate-600 text-sm sm:text-base\">\n                            <li class=\"flex items-start gap-2.5\">\n                                <i class=\"fas fa-info-circle text-primary mt-1\"></i>\n                                <span>本服务仅供学习研究使用</span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\">\n                                <i class=\"fas fa-ban text-error mt-1\"></i>\n                                <span>请勿滥用，否则可能会被限制访问</span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\">\n                                <i class=\"fas fa-link text-primary mt-1\"></i>\n                                <span>如果遇到问题，请检查链接格式是否正确</span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\">\n                                <i class=\"fas fa-bookmark text-primary mt-1\"></i>\n                                <span>建议收藏本站，以便日后使用</span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\">\n                                <i class=\"fas fa-sync-alt text-primary mt-1\"></i>\n                                <span>转换工具会自动更新，无需手动升级</span>\n                            </li>\n                            <li class=\"flex items-start gap-2.5\">\n                                <i class=\"fas fa-globe text-primary mt-1\"></i>\n                                <span>选择最适合您网络环境的区域节点</span>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Waline Comment Box -->\n            <div id=\"waline\" class=\"mt-8 border border-slate-200/80 rounded-xl bg-white p-6 sm:p-8 shadow-sm\"></div>\n\n            <!-- Sponsor Ad Banner -->\n            <div class=\"mt-8 mb-8 w-full max-w-[800px] mx-auto space-y-4\">\n                <div class=\"text-xs text-slate-400 dark:text-slate-500 mb-2 flex items-center justify-center gap-1.5 font-medium\">\n                    <i class=\"fa-solid fa-hand-holding-dollar text-primary text-[10px]\"></i>\n                    <span>赞助商</span>\n                </div>\n                <a href=\"https://secbit.ai/zh-tw/\" alt=\"secbit\" target=\"_blank\"\n                    class=\"block w-full rounded-lg overflow-hidden border border-slate-200/80 dark:border-slate-700/80 shadow-sm transition-all hover:scale-[1.005]\">\n                    <img src=\"https://hkr2.gh-proxy.com/banner-1.gif\" alt=\"secbit\" class=\"w-full h-auto block mx-auto\"\n                        loading=\"lazy\">\n                </a>\n                <a href=\"https://peekabo.io/\" alt=\"sponsor\" target=\"_blank\"\n                    class=\"block w-full rounded-lg overflow-hidden border border-slate-200/80 dark:border-slate-700/80 shadow-sm transition-all hover:scale-[1.005]\">\n                    <img src=\"https://hkr2.gh-proxy.com/banner-2.webp\" alt=\"sponsor\" class=\"w-full h-auto block mx-auto\"\n                        loading=\"lazy\">\n                </a>\n            </div>\n            \n            <!-- Footer -->\n            <footer class=\"text-center pt-8 pb-4 mt-8 text-sm text-slate-500 border-t border-slate-200\">\n                <p class=\"mb-1\">本站部署为原创后端</p>\n                <p class=\"mb-1\">网页BUG反馈，赞助及广告合作请联系：mail(at)gh-proxy.com</p>\n                <p class=\"opacity-80 mt-3\">© 2022-2026 GitHub加速工具 | 为开发者提供高速稳定的GitHub访问体验</p>\n            </footer>\n        </main>\n    </div>\n\n    <!-- QR Code Modal -->\n    <div id=\"qrModal\" class=\"fixed inset-0 z-[9990] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300\">\n        <div class=\"relative bg-white dark:bg-slate-800 rounded-2xl max-w-sm w-full p-6 shadow-2xl border border-slate-200/80 dark:border-slate-700/80 transform scale-95 transition-all duration-300\" id=\"qrModalContent\">\n            <!-- Header -->\n            <div class=\"flex justify-between items-center mb-4\">\n                <h3 class=\"text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n                    <i class=\"fa-solid fa-qrcode text-primary\"></i>\n                    <span>扫描二维码下载</span>\n                </h3>\n                <button id=\"closeQrModal\" class=\"text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700/50 focus:outline-none\">\n                    <i class=\"fa-solid fa-xmark text-lg\"></i>\n                </button>\n            </div>\n            \n            <!-- Body -->\n            <div class=\"flex flex-col items-center justify-center bg-slate-50 dark:bg-slate-900 rounded-xl p-6 border border-slate-100 dark:border-slate-800\">\n                <canvas id=\"qrCanvas\" class=\"bg-white p-2 rounded-lg shadow-inner max-w-full h-auto\"></canvas>\n                <p id=\"qrModalTip\" class=\"text-xs text-slate-500 dark:text-slate-400 mt-4 text-center\">\n                    使用手机相机或扫码软件扫描上方二维码\n                </p>\n            </div>\n\n            <!-- Footer / Info -->\n            <div class=\"mt-4\">\n                <div class=\"text-xs text-slate-400 dark:text-slate-500 mb-1\">加速链接</div>\n                <div id=\"qrModalLink\" class=\"font-mono text-xs p-2.5 bg-slate-50 dark:bg-slate-900 rounded border border-slate-100 dark:border-slate-800 break-all text-slate-600 dark:text-slate-400 select-all max-h-[80px] overflow-y-auto\"></div>\n            </div>\n        </div>\n    </div>\n\n    <div id=\"toast-container\" class=\"fixed bottom-5 right-5 z-[9999] flex flex-col gap-3 max-w-sm w-full px-4\"></div>\n\n    <script>\n        const Elements = {\n            input: document.getElementById('githubLinkInput'),\n            errorMsg: document.getElementById('error-message'),\n            outputArea: document.getElementById('output'),\n            cfLink: document.getElementById('cfLink'),\n            hkLink: document.getElementById('hkLink'),\n            cdnLink: document.getElementById('cdnLink'),\n            v6Link: document.getElementById('v6Link'),\n            formatToggle: document.getElementById('format-toggle'),\n            convertBtn: document.getElementById('convertButton'),\n            navbarToggle: document.getElementById('navbarToggle'),\n            navbarLinks: document.getElementById('navbarLinks'),\n            formattedLinkOutput: document.getElementById('formattedLinkOutput'),\n            errorText: document.querySelector('#error-message span')\n        };\n\n        const REGIONS = [\n            { id: 'cf', name: 'cloudflare (v4)', domain: 'gh-proxy.org' },\n            { id: 'hk', name: 'Cloudflare (v4)', domain: 'v4.gh-proxy.org' },\n            { id: 'v6', name: 'Cloudflare (v4/v6)', domain: 'v6.gh-proxy.org' },\n            { id: 'cdn', name: 'Fastly (v4)', domain: 'cdn.gh-proxy.org' }\n        ];\n\n        function toggleNavMenu() {\n            const isHidden = Elements.navbarLinks.classList.contains('hidden');\n            if (isHidden) {\n                Elements.navbarLinks.classList.remove('hidden');\n                Elements.navbarLinks.classList.remove('mobile-menu-enter');\n                Elements.navbarLinks.classList.add('mobile-menu-show');\n            } else {\n                Elements.navbarLinks.classList.add('mobile-menu-enter');\n                Elements.navbarLinks.classList.remove('mobile-menu-show');\n                setTimeout(() => Elements.navbarLinks.classList.add('hidden'), 300);\n            }\n        }\n\n        function showToast(message, isError = false) {\n            const toast = document.createElement('div');\n            toast.className = `bg-white text-slate-800 px-5 py-4 rounded-lg shadow-[0_5px_15px_rgba(0,0,0,0.1)] border-l-4 flex items-center gap-3 toast-enter ${isError ? 'border-error' : 'border-success'}`;\n            toast.innerHTML = `<i class=\"${isError ? 'fas fa-exclamation-circle text-error' : 'fas fa-check-circle text-success'} text-xl\"></i> <span class=\"font-medium\">${message}</span>`;\n            document.getElementById('toast-container').appendChild(toast);\n\n            // Trigger reflow\n            void toast.offsetWidth;\n\n            toast.classList.add('toast-show');\n\n            setTimeout(() => {\n                toast.classList.remove('toast-show');\n                setTimeout(() => toast.remove(), 300);\n            }, 3000);\n        }\n\n        function displayError(message) {\n            Elements.errorText.textContent = message || '';\n            if (message) {\n                Elements.errorMsg.classList.remove('hidden');\n            } else {\n                Elements.errorMsg.classList.add('hidden');\n            }\n        }\n\n        function generateLinks(userInput, format) {\n            let originalUrl = userInput.trim();\n\n            // Remove 'git clone ' or similar prefixes if entered by user\n            originalUrl = originalUrl.replace(/^(git\\s+clone\\s+|wget\\s+|curl\\s+-O\\s+)/i, '');\n\n            // Clean quotes\n            originalUrl = originalUrl.replace(/^[\"']|[\"']$/g, '');\n\n            if (!originalUrl) {\n                return { error: '请输入有效的 GitHub 相关链接' };\n            }\n\n            if (!originalUrl.includes('.') && originalUrl.includes('/')) {\n                originalUrl = `https://github.com/${originalUrl}`;\n            } else if (!originalUrl.startsWith('http://') && !originalUrl.startsWith('https://')) {\n                originalUrl = `https://${originalUrl}`;\n            }\n\n            try {\n                const url = new URL(originalUrl);\n                const validHostnames = [\n                    'github.com', 'raw.githubusercontent.com', 'gist.github.com', 'gist.githubusercontent.com', 'api.github.com',\n                    'avatars.githubusercontent.com', 'desktop.githubusercontent.com'\n                ];\n                if (!validHostnames.some(domain => url.hostname === domain || url.hostname.endsWith('.' + domain))) {\n                    return { error: '请输入有效的 GitHub 相关链接' };\n                }\n\n                let finalUrlForProxy = url.href;\n                if (format === 'git') {\n                    const allowedGitHosts = ['github.com', 'www.github.com'];\n                    if (!allowedGitHosts.includes(url.hostname)) {\n                        return { error: 'Git Clone 功能仅支持 github.com 的仓库链接。' };\n                    }\n                    const parts = url.pathname.split('/').filter(part => part);\n                    if (parts.length < 2) {\n                        return { error: 'Git Clone 需要一个有效的仓库链接 (例如 user/repo)' };\n                    }\n                    const user = parts[0];\n                    const repo = parts[1].replace(/\\.git$/, '');\n                    finalUrlForProxy = `${url.origin}/${user}/${repo}.git`;\n                }\n\n                return REGIONS.map(region => {\n                    const baseUrl = `https://${region.domain}/${finalUrlForProxy}`;\n                    if (format === 'git') {\n                        return `git clone ${baseUrl}`;\n                    } else if (format === 'wget') {\n                        return `wget \"${baseUrl}\"`;\n                    } else {\n                        return baseUrl;\n                    }\n                });\n            } catch (e) {\n                return { error: '请输入一个有效的 URL 格式' };\n            }\n        }\n\n        function safeCopyToClipboard(text) {\n            if (navigator.clipboard && navigator.clipboard.writeText) {\n                return navigator.clipboard.writeText(text).then(() => true).catch(() => false);\n            }\n            try {\n                const textArea = document.createElement('textarea');\n                textArea.value = text;\n                textArea.style.position = 'fixed';\n                textArea.style.opacity = '0';\n                document.body.appendChild(textArea);\n                textArea.focus();\n                textArea.select();\n                const success = document.execCommand('copy');\n                document.body.removeChild(textArea);\n                return Promise.resolve(!!success);\n            } catch (err) {\n                console.error('复制失败:', err);\n                return Promise.resolve(false);\n            }\n        }\n\n        function handleConversion() {\n            displayError();\n            const userInput = Elements.input.value;\n\n            if (!userInput.trim()) {\n                Elements.outputArea.classList.add('hidden');\n                showToast('请输入 GitHub 相关链接', true);\n                return;\n            }\n\n            const activeBtn = Elements.formatToggle.querySelector('.active-format');\n            const selectedFormat = activeBtn ? activeBtn.dataset.value : 'raw';\n            const result = generateLinks(userInput, selectedFormat);\n\n            if (result.error) {\n                displayError(result.error);\n                Elements.outputArea.classList.add('hidden');\n                showToast(result.error, true);\n            } else {\n                Elements.cfLink.textContent = result[0];\n                Elements.hkLink.textContent = result[1];\n                Elements.v6Link.textContent = result[2];\n                Elements.cdnLink.textContent = result[3];\n\n                Elements.outputArea.classList.remove('hidden');\n\n                const openButtons = document.querySelectorAll('.open-btn');\n                openButtons.forEach(btn => {\n                    btn.style.display = selectedFormat === 'raw' ? 'flex' : 'none';\n                });\n\n                const qrButtons = document.querySelectorAll('.qr-btn');\n                qrButtons.forEach(btn => {\n                    btn.style.display = selectedFormat === 'raw' ? 'flex' : 'none';\n                });\n\n                document.querySelectorAll('.link-item').forEach((container, index) => {\n                    container.style.opacity = 0;\n                    container.style.transform = 'translateY(20px)';\n                    setTimeout(() => {\n                        container.style.transition = 'all 0.4s ease';\n                        container.style.opacity = 1;\n                        container.style.transform = 'translateY(0)';\n                    }, index * 100);\n                });\n\n                showToast('链接转换成功！');\n            }\n        }\n\n        function copyCodeBlock(id) {\n            const preElement = document.getElementById(id);\n            if (!preElement) return;\n            safeCopyToClipboard(preElement.innerText).then(success => {\n                if (success) {\n                    showToast('已复制配置内容到剪贴板');\n                } else {\n                    showToast('复制失败，请手动复制', true);\n                }\n            });\n        }\n\n        const qrModal = document.getElementById('qrModal');\n        const qrModalContent = document.getElementById('qrModalContent');\n        const closeQrModalBtn = document.getElementById('closeQrModal');\n        const qrCanvas = document.getElementById('qrCanvas');\n        const qrModalLink = document.getElementById('qrModalLink');\n\n        function openQrModal(linkText) {\n            qrModalLink.textContent = linkText;\n            \n            // Generate QR code\n            QRCode.toCanvas(qrCanvas, linkText, {\n                width: 220,\n                margin: 1,\n                color: {\n                    dark: '#0f172a',\n                    light: '#ffffff'\n                }\n            }, function (error) {\n                if (error) {\n                    console.error(error);\n                    showToast('生成二维码失败', true);\n                    return;\n                }\n                \n                // Show modal with animation\n                qrModal.classList.remove('opacity-0', 'pointer-events-none');\n                qrModalContent.classList.remove('scale-95');\n                qrModalContent.classList.add('scale-100');\n            });\n        }\n\n        function closeQrModal() {\n            qrModal.classList.add('opacity-0', 'pointer-events-none');\n            qrModalContent.classList.remove('scale-100');\n            qrModalContent.classList.add('scale-95');\n        }\n\n        function initTheme() {\n            const themeToggleBtn = document.getElementById('themeToggleBtn');\n            const themeToggleIcon = document.getElementById('themeToggleIcon');\n\n            function updateThemeUI() {\n                const isDark = document.documentElement.classList.contains('dark');\n                if (isDark) {\n                    themeToggleIcon.className = 'fa-solid fa-sun text-lg';\n                } else {\n                    themeToggleIcon.className = 'fa-solid fa-moon text-lg';\n                }\n            }\n\n            // Initialize UI on load\n            updateThemeUI();\n\n            themeToggleBtn.addEventListener('click', () => {\n                const isDark = document.documentElement.classList.contains('dark');\n                if (isDark) {\n                    document.documentElement.classList.remove('dark');\n                    localStorage.setItem('theme', 'light');\n                } else {\n                    document.documentElement.classList.add('dark');\n                    localStorage.setItem('theme', 'dark');\n                }\n                updateThemeUI();\n            });\n        }\n\n        function initPage() {\n            // Output links copy click handler\n            Elements.formattedLinkOutput.addEventListener('click', function (event) {\n                const copyBtn = event.target.closest('.copy-btn');\n                const openBtn = event.target.closest('.open-btn');\n                const qrBtn = event.target.closest('.qr-btn');\n                if (copyBtn) {\n                    const region = copyBtn.dataset.region;\n                    const linkElement = document.getElementById(`${region}Link`);\n                    safeCopyToClipboard(linkElement.textContent).then(success => {\n                        if (success) {\n                            const regionName = REGIONS.find(r => r.id === region)?.name || region;\n                            showToast(`已复制 ${regionName} 加速链接`);\n                        } else {\n                            showToast('复制失败，请手动复制', true);\n                        }\n                    });\n                }\n                if (openBtn) {\n                    const region = openBtn.dataset.region;\n                    const linkElement = document.getElementById(`${region}Link`);\n                    window.open(linkElement.textContent, '_blank');\n                }\n                if (qrBtn) {\n                    const region = qrBtn.dataset.region;\n                    const linkElement = document.getElementById(`${region}Link`);\n                    if (linkElement && linkElement.textContent) {\n                        openQrModal(linkElement.textContent.trim());\n                    }\n                }\n            });\n\n            // QR Modal listeners\n            if (closeQrModalBtn && qrModal) {\n                closeQrModalBtn.addEventListener('click', closeQrModal);\n                qrModal.addEventListener('click', (e) => {\n                    if (e.target === qrModal) {\n                        closeQrModal();\n                    }\n                });\n            }\n\n            Elements.formatToggle.addEventListener('click', (e) => {\n                const button = e.target.closest('button');\n                if (!button || button.classList.contains('active-format')) return;\n\n                Array.from(Elements.formatToggle.children).forEach(btn => {\n                    btn.className = 'flex-1 min-w-[100px] px-4 py-3 bg-slate-50 text-slate-700 border border-slate-200 font-medium rounded-lg text-sm sm:text-base text-center transition-all hover:bg-slate-100 hover:border-slate-300 format-btn';\n                    btn.classList.remove('active-format');\n                });\n\n                button.className = 'flex-1 min-w-[100px] px-4 py-3 bg-primary text-white border border-primary font-medium rounded-lg text-sm sm:text-base text-center transition-all active-format shadow-md';\n                button.classList.add('active-format');\n\n                if (Elements.input.value.trim()) {\n                    handleConversion();\n                }\n            });\n\n            // Tab switcher\n            const tabButtons = document.querySelectorAll('.tab-btn');\n            tabButtons.forEach(btn => {\n                btn.addEventListener('click', () => {\n                    // Reset all tab headers\n                    tabButtons.forEach(b => {\n                        b.classList.remove('border-primary', 'text-primary');\n                        b.classList.add('border-transparent', 'text-slate-600');\n                    });\n                    // Highlight active tab header\n                    btn.classList.remove('border-transparent', 'text-slate-600');\n                    btn.classList.add('border-primary', 'text-primary');\n\n                    // Hide all tab panes\n                    document.querySelectorAll('.tab-pane').forEach(pane => {\n                        pane.classList.remove('block');\n                        pane.classList.add('hidden');\n                    });\n                    // Show target tab pane\n                    const targetId = btn.dataset.target;\n                    const targetPane = document.getElementById(targetId);\n                    if (targetPane) {\n                        targetPane.classList.remove('hidden');\n                        targetPane.classList.add('block');\n                    }\n                });\n            });\n\n            Elements.convertBtn.addEventListener('click', handleConversion);\n\n            Elements.input.addEventListener('keypress', (e) => {\n                if (e.key === 'Enter') {\n                    e.preventDefault();\n                    handleConversion();\n                }\n            });\n\n            // Collapsible container for shili-code\n            const shiliContainer = document.getElementById('shili-code-container');\n            const shiliOverlay = document.getElementById('shili-code-overlay');\n            const shiliToggleBtn = document.getElementById('shili-toggle-btn');\n            if (shiliContainer && shiliOverlay && shiliToggleBtn) {\n                shiliToggleBtn.addEventListener('click', () => {\n                    const isCollapsed = shiliContainer.classList.contains('max-h-[150px]');\n                    if (isCollapsed) {\n                        shiliContainer.classList.remove('max-h-[150px]');\n                        shiliOverlay.classList.add('opacity-0');\n                        shiliToggleBtn.innerHTML = '<i class=\"fas fa-chevron-up\"></i> 收起';\n                    } else {\n                        shiliContainer.classList.add('max-h-[150px]');\n                        shiliOverlay.classList.remove('opacity-0');\n                        shiliToggleBtn.innerHTML = '<i class=\"fas fa-chevron-down\"></i> 展开全部';\n                    }\n                });\n            }\n\n            Elements.navbarToggle.addEventListener('click', toggleNavMenu);\n            initTheme();\n        }\n\n        // Mobile dropdown interaction\n        document.querySelectorAll('#navbarLinks .group').forEach(item => {\n            const link = item.querySelector('.nav-link');\n            const dropdown = item.querySelector('.dropdown-menu');\n\n            if (dropdown && link) {\n                link.addEventListener('click', (e) => {\n                    if (window.innerWidth < 768) {\n                        e.preventDefault();\n                        e.stopPropagation();\n                        document.querySelectorAll('#navbarLinks .group').forEach(otherItem => {\n                            if (otherItem !== item) {\n                                otherItem.classList.remove('active');\n                            }\n                        });\n                        item.classList.toggle('active');\n                    }\n                });\n            }\n        });\n\n        document.addEventListener('click', (e) => {\n            if (window.innerWidth < 768 && !Elements.navbarLinks.classList.contains('hidden') && !e.target.closest('nav')) {\n                toggleNavMenu();\n            }\n        });\n\n        // Click handler to run example link on click\n        document.getElementById('shili-code').addEventListener('click', (e) => {\n            const text = e.currentTarget.innerText;\n            const clickedText = window.getSelection().toString().trim();\n            if (clickedText && (clickedText.startsWith('http') || clickedText.startsWith('git clone'))) {\n                // If user selected text, do nothing\n                return;\n            }\n\n            // Find click position or line\n            const selection = window.getSelection();\n            if (!selection.rangeCount) return;\n\n            const range = selection.getRangeAt(0);\n            const container = range.startContainer;\n            const textContent = container.textContent;\n\n            // Extract the line clicked\n            const offset = range.startOffset;\n            let start = offset;\n            while (start > 0 && textContent[start - 1] !== '\\n') {\n                start--;\n            }\n            let end = offset;\n            while (end < textContent.length && textContent[end] !== '\\n') {\n                end++;\n            }\n            let line = textContent.substring(start, end).trim();\n\n            // Check if it's git clone pattern or raw links\n            if (line.includes('git:git clone ')) {\n                line = line.substring(line.indexOf('https://'));\n            } else if (line.startsWith('git clone ')) {\n                line = line.replace('git clone ', '');\n            } else if (line.includes('：https://')) {\n                line = line.substring(line.indexOf('https://'));\n            } else if (line.includes(':https://')) {\n                line = line.substring(line.indexOf('https://'));\n            }\n\n            if (line && (line.startsWith('http://') || line.startsWith('https://'))) {\n                Elements.input.value = line;\n                handleConversion();\n                // Scroll to input card smoothly\n                Elements.input.scrollIntoView({ behavior: 'smooth', block: 'center' });\n            }\n        });\n\n        initPage();\n    </script>\n    <script>\n        /**\n         *\n         * Waline 评论系统初始化\n         *\n         */\n        document.addEventListener('DOMContentLoaded', async function () {\n            const { init } = await import('https://unpkg.com/@waline/client@3.15.2/dist/waline.js');\n\n            const waline = init({\n                el: \"#waline\",\n                serverURL: \"https://waline.gh-proxy.com\",\n                path: \"comment\", // 当前文章页路径，用于区分不同的文章页\n                dark: 'html.dark',\n                pageSize: 5,\n                copyright: true,\n                reaction: [\n                    \"https://hkr2.gh-proxy.com/emojis/bilibili/bb_heart_eyes.png\",\n                    \"https://hkr2.gh-proxy.com/emojis/bilibili/bb_thumbsup.png\",\n                    \"https://hkr2.gh-proxy.com/emojis/bilibili/bb_zhoumei.png\",\n                    \"https://hkr2.gh-proxy.com/emojis/bilibili/bb_