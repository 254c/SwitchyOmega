d whitespace-nowrap text-cdn bg-cdnBg\">\n                                <i class=\"fas fa-map-marker-alt\"></i> Fastly (v4)\n                            </span>\n                            <span class=\"text-sm text-slate-600\">Fastly CDN 节点加速。</span>\n                        </div>\n                        <div class=\"flex flex-col gap-3\">\n                            <div id=\"cdnLink\"\n                                class=\"font-mono text-sm leading-relaxed bg-black/5 p-4 rounded-md border border-black/5 break-all text-slate-800\">\n                            </div>\n                            <div class=\"flex flex-wrap gap-2\">\n                                <button\n                                    class=\"flex-1 min-w-[100px] flex items-center justify-center gap-2 bg-white border border-slate-200 text-slate-700 py-2.5 px-4 rounded-md text-sm font-medium hover:bg-green-500 hover:text-white hover:border-green-500 transition-colors copy-btn\"\n                                    data-region=\"cdn\">\n                                    <i class=\"fas fa-copy\"></i> 复制链接\n                                </button>\n                                <button\n                                    class=\"flex-1 min-w-[100px] flex items-center justify-center gap-2 bg-white border border-slate-200 text-slate-700 py-2.5 px-4 rounded-md text-sm font-medium hover:bg-primary hover:text-white hover:border-primary transition-colors open-btn\"\n                                    data-region=\"cdn\">\n                                    <i class=\"fas fa-external-link-alt\"></i> 打开\n                                </button>\n                                <button\n                                    class=\"flex-1 min-w-[100px] flex items-center justify-center gap-2 bg-white border border-slate-200 text-slate-700 py-2.5 px-4 rounded-md text-sm font-medium hover:bg-cdn hover:text-white hover:border-cdn transition-colors qr-btn\"\n                                    data-region=\"cdn\">\n                                    <i class=\"fas fa-qrcode\"></i> 二维码\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n\n                    <p class=\"text-slate-500 text-sm mt-4 flex items-center gap-1.5\">\n                        <i class=\"fa-solid fa-circle-exclamation text-primary\"></i>\n                        任一子加速节点不可用后预计会在 15 分钟内自动重定向至主站加速。\n                    </p>\n                </div>\n            </div>\n\n            <!-- Configuration and Guides Card -->\n            <div id=\"guide-card\"\n                class=\"bg-white rounded-xl shadow-[0_4px_20px_rgba(0,0,0,0.03)] border border-slate-200/80 overflow-hidden mb-8\">\n                <!-- Tab Headers -->\n                <div class=\"flex overflow-x-auto border-b border-slate-200 bg-slate-50/50 scrollbar-none\"\n                    id=\"config-tabs\">\n                    <button\n                        class=\"px-5 py-4 font-semibold text-sm border-b-2 border-primary text-primary transition-all focus:outline-none tab-btn whitespace-nowrap\"\n                        data-target=\"shili-tab\">正确输入示例</button>\n                    <button\n                        class=\"px-5 py-4 font-semibold text-sm border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition-all focus:outline-none tab-btn whitespace-nowrap\"\n                        data-target=\"features-tab\">功能特点</button>\n                    <button\n                        class=\"px-5 py-4 font-semibold text-sm border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition-all focus:outline-none tab-btn whitespace-nowrap\"\n                        data-target=\"resources-tab\">支持的 GitHub 资源</button>\n                    <button\n                        class=\"px-5 py-4 font-semibold text-sm border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition-all focus:outline-none tab-btn whitespace-nowrap\"\n                        data-target=\"note-tab\">注意事项</button>\n                </div>\n\n                <!-- Tab Contents -->\n                <div class=\"p-6 sm:p-8\" id=\"tab-contents\">\n                    <!-- Tab 1: 正确输入示例 -->\n                    <div id=\"shili-tab\" class=\"tab-pane block space-y-4\">\n                        <h4 class=\"text-lg font-bold text-slate-800 flex items-center gap-2 mb-2\">\n                            <i class=\"fa-solid fa-list-check text-primary\"></i> 正确输入示例\n                        </h4>\n                        <p class=\"text-sm text-slate-600 mb-4\">本加速工具支持转换以下任意格式的 GitHub 资源链接。点击示例文本可自动填入上方输入框并转换：</p>\n                        <div class=\"relative bg-slate-900 rounded-lg shadow-inner\">\n                            <button\n                                class=\"absolute top-3 right-3 text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 py-1.5 px-3 rounded border border-slate-700 transition-all flex items-center gap-1.5 z-10\"\n                                onclick=\"copyCodeBlock('shili-code')\">\n                                <i class=\"fas fa-copy\"></i> 复制全部\n                            </button>\n                            <div id=\"shili-code-container\"\n                                class=\"max-h-[150px] overflow-hidden transition-all duration-300 p-5\">\n                                <pre id=\"shili-code\"\n                                    class=\"text-slate-200 font-mono text-sm leading-relaxed overflow-x-auto cursor-pointer\"># 分支源码\nhttps://github.com/WJQSERVER-STUDIO/ghproxy/archive/refs/heads/main.zip\n\n# raw文件\nhttps://github.com/WJQSERVER-STUDIO/ghproxy/blob/main/config/config.toml\nhttps://raw.githubusercontent.com/WJQSERVER-STUDIO/ghproxy/refs/heads/main/config/config.toml\n\n# Release源码\nhttps://github.com/WJQSERVER-STUDIO/ghproxy/archive/refs/tags/4.3.4.zip\n\n# Release文件\nhttps://github.com/WJQSERVER-STUDIO/ghproxy/releases/download/4.3.4/ghproxy-linux-amd64.tar.gz\n\n# gist\nhttps://gist.githubusercontent.com/oopsunix/2dbf20f64984773da6740d1d1cf7c2d4/raw/github-blacklist\n\n# api\nhttps://api.github.com/repos/umami-software/umami\n\n# GitHub 头像 (avatars)\nhttps://avatars.githubusercontent.com/u/10000?v=4\n\n# GitHub Desktop 客户端发布文件 (desktop)\nhttps://desktop.githubusercontent.com/releases/3.6.2-beta1-f62b1c7a/GitHubDesktop-x64.zip\n\n# git\ngit clone https://gh-proxy.com/https://github.com/WJQSERVER-STUDIO/ghproxy.git\n\n#nightly.link\n打开网站查看示例https://nightly.link/</pre>\n                            </div>\n                            <div id=\"shili-code-overlay\"\n                                class=\"absolute bottom-0 left-0 w-full h-20 bg-gradient-to-t from-slate-900 to-transparent pointer-events-none transition-opacity duration-300\">\n                            </div>\n                        </div>\n                        <div class=\"flex justify-center mt-3\">\n                            <button id=\"shili-toggle-btn\"\n                                class=\"px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-sm font-semibold transition-all flex items-center gap-1.5\">\n                                <i class=\"fas fa-chevron-down\"></i> 展开全部\n                            </button>\n                        </div>\n                    </div>\n\n                    <!-- Tab 2: 功能特点 -->\n                    <div id=\"features-tab\" class=\"tab-pane hidden space-y-4\">\n                        <h4 class=\"text-lg font-bold text-slate-800 flex items-center gap-2 mb-4\">\n                            <i class=\"fas fa-star text-primary\"></i> 功能特点\n                        </h4>\n                        <ul class=\"space-y-3 text-slate-600 text-sm sm:text-base\">\n                            <li class=\"flex items-start gap-2.5\">\n                                <i class=\"fas fa-check-circle text-success mt-1\"></i>\n                                <span>支持代理访问 GitHub 的 Releases、Raw、Ar